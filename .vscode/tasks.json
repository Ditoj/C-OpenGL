{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Build OpenGL File",
			"command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
			"args": [
				"-I${cwd}/include",
				"-L${cwd}/lib",
				"${cwd}/src/main.c",
				"${cwd}/src/glad.c",
				"${cwd}/include/renderer/renderer.c",
				"${cwd}/include/texture/texture.c",
				"${cwd}/include/buffers/buffer_base.c",
				"${cwd}/include/buffers/vertex_buffer.c",
				"${cwd}/include/buffers/index_buffer.c",
				"${cwd}/include/vertex_array/vertex_array.c",
				"${cwd}/include/shader/shader.c",
				"${cwd}/include/file/file.c",
				"-lglfw3dll",
				"-lopengl32",
				"-o${cwd}/bin/program.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: C:\\msys64\\ucrt64\\bin\\gcc.exe"
		}
	]
}